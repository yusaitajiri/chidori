# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---- Rust ----
target/
**/*.rs.bk
*.pdb

# Khronos Vulkan loader, fetched by `cargo xtask dist` at build time
crates/app/resources/vulkan/
# Third-party licence list, written by `cargo xtask dist` (or `notices`) at build time
crates/app/resources/licenses/THIRD-PARTY-NOTICES.txt

# Updater signing keys - never commit these
*.key
*.key.pub

# ---- Whisper models (hundreds of MB, downloaded at runtime) ----
models/*.bin
models/*.gguf
*.bin

# ---- Local session output / recordings ----
sessions/
*.wav.local
*.jsonl.local

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---- Test / coverage ----
coverage/
.nyc_output/

# ---- Generated test fixtures (see tests/fixtures/README.md) ----
tests/fixtures/generated/
tests/fixtures/cache/

TO-IMPROVE.md

